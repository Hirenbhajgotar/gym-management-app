APP_NAME=FitnessFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Test database name (used by phpunit, --env=testing, and app:test-db-fresh).
# Mirrors the value used in phpunit.xml (DB_DATABASE) and .env.testing.
# The MySQL container auto-creates this database on first boot via
# docker/mysql-test-init/01-create-test-db.sh.
MYSQL_TEST_DATABASE=gym_app_test

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Recommended true in production. One-time credential reveals are encrypted in the
# configured cache (not the session table); production therefore needs a shared,
# lock-capable cache store (Redis/database/memcached) so every app node can claim
# the same one-time value.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
BROADCAST_QUEUE=broadcast
NOTIFICATIONS_QUEUE=notifications

CACHE_STORE=redis
CACHE_PREFIX=fitness_flow_gym_app_cache

MEMCACHED_HOST=127.0.0.1

# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# CACHE_DRIVER=redis
# REDIS_CLIENT=predis
# REDIS_HOST=redis
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_SESSION_DB=2


MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

SUPPORT_MAIL="contact@sidcraft.com"
SUPPORT_CONTACT="9265098227"
CONTACT_PHONE="+919265098227"
CONTACT_EMAIL="contact@fitnessflow.com"

# Request Demo & Proxy Settings
REQUEST_DEMO_FORCE_CONTACT_EMAIL=
REQUEST_DEMO_DNS_CHECK_ENABLED=true
REQUEST_DEMO_DNS_CACHE_TTL=86400
REQUEST_DEMO_DNS_NEGATIVE_CACHE_TTL=300
REQUEST_DEMO_RATE_LIMIT_MAX=3
REQUEST_DEMO_RATE_LIMIT_DECAY=3600
TRUSTED_PROXIES=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


REVERB_APP_ID=219010
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="0.0.0.0"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

AUTO_ERROR_REPORTING=false

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_USE_SANDBOX=true
TWILIO_SANDBOX_NUMBER=
TWILIO_WABA_ID=
TWILIO_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
TWILIO_BIRTHDAY_GREETING_TEMPLATE_SID=
TWILIO_WHATSAPP_INTEGRATION_ACTIVE_V5_TEMPLATE_SID=
TWILIO_DEMO_REQUEST_TEMPLATE_SID=
TWILIO_MEMBERSHIP_EXPIRY_TEMPLATE_SID=
TWILIO_LEAD_FOLLOWUP_REMINDER_TEMPLATE_SID=
TWILIO_PENDING_LEAD_REMINDER_TEMPLATE_SID=
LOW_WHATSAPP_MESSAGE_BALANCE_TEMPLATE_SID=

# Individual WABA Configuration (for multi-tenant isolation)
TWILIO_USE_INDIVIDUAL_WABA=false
TWILIO_EMBEDDED_SIGNUP_ENABLED=false
TWILIO_MARGIN_PERCENTAGE=0.10
TWILIO_COST_PER_MESSAGE=1.53
TWILIO_EXCHANGE_RATE=90.0
TWILIO_NUMBER_COST=136.41
TWILIO_NUMBER_SURCHARGE_DAYS=30

# Meta/Facebook Integration (for Embedded Signup)
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v25.0
META_REDIRECT_URI=
META_CONFIG_ID=
WHATSAPP_DEFAULT_PROVIDER="waba"
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

GITHUB_PERSONAL_ACCESS_TOKEN=
OPEN_ROUTER_API_KEY=
FIRECRAWL_API_KEY=
DEEPSEEK_API_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SYSTEM_TENANT_ID="system"
LOW_WHATSAPP_MESSAGE_BALANCE_THRESHOLD=5
WHATSAPP_BROADCAST_LIMIT_PER_DAY=2

BIOMETRIC_LIVENESS_THRESHOLD=0.75
BIOMETRIC_CONFIDENCE_THRESHOLD=0.80
BIOMETRIC_SIMILARITY_THRESHOLD=0.85
BIOMETRIC_CONSENT_EMAIL_DELAY=1
# Validity window, in days, of the signed biometric consent URL. The link is an
# unauthenticated bearer credential, so this is security-relevant: clamped to 1..30.
BIOMETRIC_CONSENT_URL_EXPIRY_DAYS=7
# Cloud AI Biometric Recognition Providers (Managed at SaaS/System level)
AWS_REKOGNITION_KEY=
AWS_REKOGNITION_SECRET=
AWS_REKOGNITION_REGION=us-east-1
AZURE_FACE_ENDPOINT=
AZURE_FACE_KEY=
AZURE_FACE_LOCATION="eastus"
BIOID_WSDL_URL="https://bws.bioid.com/extension"
BIOID_APP_ID=
BIOID_API_KEY=
BIOID_SERVICE_ID=0
# Door controller URL security - comma-separated list of allowed domains (e.g., "door-controller.local,192.168.1.100")
BIOMETRIC_TRUSTED_DOMAINS=
# Door controller URL security - comma-separated list of allowed CIDR subnets (e.g., "192.168.1.0/24"). Leave empty to deny all.
BIOMETRIC_TRUSTED_SUBNETS=
BIOMETRIC_ANTI_PASSBACK_WINDOW_SECONDS=60
BIOMETRIC_DEVICE_THROTTLE=120

# ADMS Push Protocol Configuration
ADMS_ENABLED=true
ADMS_REQUIRE_COMM_KEY=false
ADMS_PBKDF2_ITERATIONS=100000
# One-release compatibility fallback for verifiers created from raw whitespace-bearing keys. Disable after rotation.
ADMS_ALLOW_LEGACY_UNSANITIZED_COMM_KEY=true
# Per-device failed pushcommkey attempts before a temporary lockout.
# The per-device lockout requires a shared cache store (redis, database, memcached, or dynamodb).
ADMS_AUTH_MAX_FAILURES=5
ADMS_AUTH_LOCKOUT_SECONDS=900
ADMS_COMMAND_LEASE_SECONDS=600
ADMS_COMMAND_RETENTION_DAYS=90
ADMS_RECEIPT_RETENTION_DAYS=30
ADMS_EXPIRED_GRACE_DAYS=10
# Global ADMS user table schema: USERINFO (standard eSSL/ZKTeco) or user (modern firmware).
# A per-device override in the admin panel takes precedence. Blank or unrecognised values
# fall back to USERINFO; they are never coerced to the legacy `user` schema.
ADMS_USER_TABLE=USERINFO
# Maximum hardware deliveries per command before it is considered exhausted
ADMS_MAX_ATTEMPTS=3

# Hours an exhausted user_delete is left alone before the hourly reconciler re-drives it
ADMS_RETRY_COOLDOWN_HOURS=24

# Vendor user_delete return codes treated as "user already absent from terminal".
# Ships empty: set only the codes your firmware's delete actually returns for an absent
# user, because a wrong value turns a failed delete into a fabricated erasure. This is a
# mandatory per-firmware configuration step: ZKTeco and eSSL differ, and with the list
# empty a "no such user" reply is a FAILED delete that will be re-driven to the delivery
# cap and dead-lettered. Whenever a user_delete fails with the same non-zero code, the
# code is logged so it can be added here.
ADMS_DELETION_CONVERGENCE_CODES=

# Hours a cloud provider may keep refusing an erase before the row is parked at the
# terminal DeletionUnresolvable state and surfaced to an operator. This is a TIME budget,
# not a retry count: the hourly reconciler and the consent-revoked queue listener share the
# obligation, so a count would let a four-minute retry burst exhaust it.
BIOMETRIC_CLOUD_ERASURE_COOLDOWN_HOURS=24

# Heartbeat tuning
BIOMETRIC_HEARTBEAT_TIMEOUT_MINUTES=15
BIOMETRIC_HEARTBEAT_CONSECUTIVE_MISSES=1
OTP_EXPIRY_MINUTES=5
CHECKIN_VERIFICATION_SESSION_ID=
CHECKOUT_VERIFICATION_SESSION_ID=

TRANSACTION_DEADLOCK_MAX_ATTEMPTS=3
INVOICE_DISK="local"
WHATSAPP_TEMPLATE_LANGUAGE="en_US"

# Log Viewer Production Token
LOG_VIEWER_PRODUCTION_TOKEN=
