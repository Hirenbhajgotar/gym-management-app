APP_NAME=FitnessFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=fitness_flow_gym_app_cache

MEMCACHED_HOST=127.0.0.1

# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# CACHE_DRIVER=redis
# REDIS_CLIENT=predis
# REDIS_HOST=redis
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_SESSION_DB=2


MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

SUPPORT_MAIL="contact@sidcraft.com"
SUPPORT_CONTACT="9265098227"
CONTACT_PHONE="+919265098227"
CONTACT_EMAIL="contact@fitnessflow.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


REVERB_APP_ID=219010
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="0.0.0.0"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

AUTO_ERROR_REPORTING=false

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_USE_SANDBOX=true
TWILIO_SANDBOX_NUMBER=
TWILIO_WABA_ID=
TWILIO_BIRTHDAY_GREETING_TEMPLATE_SID=
TWILIO_WHATSAPP_INTEGRATION_ACTIVE_V5_TEMPLATE_SID=
TWILIO_DEMO_REQUEST_TEMPLATE_SID=
TWILIO_MEMBERSHIP_EXPIRY_TEMPLATE_SID=
TWILIO_LEAD_FOLLOWUP_REMINDER_TEMPLATE_SID=
TWILIO_PENDING_LEAD_REMINDER_TEMPLATE_SID=
LOW_WHATSAPP_MESSAGE_BALANCE_TEMPLATE_SID=

# Individual WABA Configuration (for multi-tenant isolation)
TWILIO_USE_INDIVIDUAL_WABA=false
TWILIO_EMBEDDED_SIGNUP_ENABLED=false

# Meta/Facebook Integration (for Embedded Signup)
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v25.0
META_REDIRECT_URI=
META_CONFIG_ID=
WHATSAPP_DEFAULT_PROVIDER="waba"

GITHUB_PERSONAL_ACCESS_TOKEN=
OPEN_ROUTER_API_KEY=
FIRECRAWL_API_KEY=
DEEPSEEK_API_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SYSTEM_TENANT_ID="system"
LOW_WHATSAPP_MESSAGE_BALANCE_THRESHOLD=5
WHATSAPP_BROADCAST_LIMIT_PER_DAY=2

BIOMETRIC_LIVENESS_THRESHOLD=0.75
BIOMETRIC_CONFIDENCE_THRESHOLD=0.80
BIOMETRIC_SIMILARITY_THRESHOLD=0.85
BIOMETRIC_FALLBACK_PIN=true
BIOMETRIC_CONSENT_EMAIL_DELAY=1
# Door controller URL security - comma-separated list of allowed domains (e.g., "door-controller.local,192.168.1.100")
BIOMETRIC_TRUSTED_DOMAINS=
# Door controller URL security - comma-separated list of allowed CIDR subnets (e.g., "192.168.1.0/24"). Leave empty to deny all.
BIOMETRIC_TRUSTED_SUBNETS=
OTP_EXPIRY_MINUTES=5
CHECKIN_VERIFICATION_SESSION_ID=
CHECKOUT_VERIFICATION_SESSION_ID=
