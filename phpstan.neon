includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    paths:
        - app/

    # Level 10 is the highest level
    level: max

    scanFiles:
        - _ide_helper_models.php

    ignoreErrors:
        - '#PHPDoc tag @var#'

        # Class name case false positive
        - '#Class App\\Models\\WhatsappTemplate referenced with incorrect case#'

        # Spatie Permission role method not recognized by PHPStan
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder(::|::role\(\))#'

#    excludePaths:
#        - ./*/*/FileToBeExcluded.php