{
  "mcpServers": {
    "firecrawl-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${env:FIRECRAWL_API_KEY}"
      }
    },
    "laravel-boost": {
      "command": "php",
      "args": [
        "artisan",
        "boost:mcp"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "^run_shell_command$",
        "hooks": [
          {
            "name": "impeccable-session",
            "type": "command",
            "command": "if (Test-Path -LiteralPath 'C:\\Users\\SID\\.gemini\\skills\\impeccable\\scripts\\impeccable.cmd') { & 'C:\\Users\\SID\\.gemini\\skills\\impeccable\\scripts\\impeccable.cmd' hook }",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "name": "impeccable-completion",
            "type": "command",
            "command": "if (Test-Path -LiteralPath 'C:\\Users\\SID\\.gemini\\skills\\impeccable\\scripts\\impeccable.cmd') { & 'C:\\Users\\SID\\.gemini\\skills\\impeccable\\scripts\\impeccable.cmd' hook }",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}